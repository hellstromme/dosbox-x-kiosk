# DOSBox-X Kiosk Edition — Minimal x86_64 Old-Laptop Appliance Defconfig
# Target: Buildroot 2025.02 LTS (< 15 MB host OS RAM, no X11/Wayland/PulseAudio/udisks2/polkit)

# Architecture
BR2_x86_64=y
BR2_x86_core2=y

# Init & Device Management (BusyBox init + eudev)
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="dosbox-kiosk"
BR2_TARGET_GENERIC_ISSUE="DOSBox-X Kiosk Appliance"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DOSBOX_X_KIOSK_PATH)/board/dosbox-x-kiosk/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DOSBOX_X_KIOSK_PATH)/board/dosbox-x-kiosk/post-image.sh"

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# Kernel & UEFI Bootloader (GRUB2 x86_64 EFI -> bzImage + tiny overlayroot initramfs)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y

# Graphics: Direct KMSDRM + Mesa3D broad old-laptop GPU support (no X11/Wayland)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=n

# SDL2 KMSDRM + ALSA + FluidSynth
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_FLUIDSYNTH=y

# DOSBox-X Kiosk & GOG/Steam Ingestion Tooling
BR2_PACKAGE_DOSBOX_X_KIOSK=y
BR2_PACKAGE_INNOEXTRACT=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_E2FSPROGS=y

# Read-Only SquashFS Root + GPT Disk Image Assembly
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
